# Your Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment the agent talks to.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Application Insights — auto-injected in hosted containers.
# Set for local telemetry (optional but recommended).
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# --- Azure Blob Storage ---
# The per-agent identity must have "Storage Blob Data Contributor" on this container.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=

# --- Azure Service Bus (queue) ---
# The per-agent identity must have "Azure Service Bus Data Sender" and "Data Receiver" on the queue.
# e.g. <namespace>.servicebus.windows.net
AZURE_SERVICEBUS_FQDN=
AZURE_SERVICEBUS_QUEUE_NAME=
