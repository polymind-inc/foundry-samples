# Your Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment the agent talks to.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# The name of the skills toolbox registered in the project, e.g. maf-skills-toolbox.
# agent-framework-js derives the MCP endpoint from the project endpoint and this name
# (the Python sample takes a full TOOLBOX_ENDPOINT URL instead — see README).
FOUNDRY_TOOLBOX_NAME=maf-skills-toolbox

# Optional: the agent's display name. Defaults to hosted-toolbox-mcp-skills.
# AGENT_NAME=
