# The build stage needs package*.json, tsconfig.json, tsdown.config.ts, and src/
# (plus bundled assets like skills/ where the Dockerfile copies them) — keep
# everything else out of the build context.
node_modules/
dist/
.env
.env.*
*.md
agent.yaml
sample.yaml
.gitignore

# Authoring inputs — the deployed agent discovers skills from the toolbox MCP
# endpoint at runtime, so the SKILL.md sources and toolbox.yaml are not needed
# in the container.
skills/
toolbox.yaml
