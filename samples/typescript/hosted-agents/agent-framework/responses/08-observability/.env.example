# Your Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment the agent talks to.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Opt in to recording prompts, completions and tool arguments on spans (sensitive data).
# Same switch as the Python framework; the standard
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT works too.
ENABLE_SENSITIVE_DATA=true

# When deployed to Foundry this is injected automatically. Set it locally to send telemetry to
# Application Insights from your machine; alternatively set OTEL_EXPORTER_OTLP_ENDPOINT for OTLP.
APPLICATIONINSIGHTS_CONNECTION_STRING=
