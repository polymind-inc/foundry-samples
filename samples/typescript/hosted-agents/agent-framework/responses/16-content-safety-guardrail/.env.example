# Your Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment the agent talks to.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Full ARM resource ID of an RAI policy on the Foundry account. The built-in
# default ends in /raiPolicies/Microsoft.DefaultV2.
RAI_POLICY_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/raiPolicies/Microsoft.DefaultV2
