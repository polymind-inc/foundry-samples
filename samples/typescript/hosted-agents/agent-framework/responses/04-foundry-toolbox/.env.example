# Your Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment the agent talks to.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# The name of the toolbox registered in your Foundry project (create it from toolbox.yaml, e.g.
# `azd ai toolbox create agent-tools --from-file ./toolbox.yaml`). The toolbox's MCP endpoint is
# built from FOUNDRY_PROJECT_ENDPOINT and this name. TOOLBOX_NAME is intentionally
# not prefixed with FOUNDRY_: that prefix is reserved by the hosted platform.
TOOLBOX_NAME=agent-tools
