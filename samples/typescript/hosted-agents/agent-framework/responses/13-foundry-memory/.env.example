# Your Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment the agent talks to (also used by the memory store's extraction).
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Embedding model deployment (only needed by src/provision.ts).
AZURE_AI_EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-small

# Name of the Foundry Memory Store the agent should read/write to.
MEMORY_STORE_NAME=agent_framework_memory

# Stable scope used only when running locally without an x-agent-user-id header.
# Hosted requests always use the platform-provided end-user id instead.
MEMORY_USER_ID=local-dev-user
