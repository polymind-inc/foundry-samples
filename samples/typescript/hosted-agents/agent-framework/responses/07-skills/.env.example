# Your Foundry project endpoint, e.g. https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# The model deployment the agent talks to.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Optional: where the skills/ directory lives. Defaults to <cwd>/skills, then next
# to the entry module — the sample root in dev, /app/skills in the container.
# SKILLS_DIR=

# Optional: where the travel-guide skill writes generated PDFs.
# Defaults to $HOME/generated-travel-guides.
# TRAVEL_GUIDE_OUTPUT_DIR=
